{
  "name": "azadi-photobooth",
  "version": "1.0.0",
  "private": true,
  "description": "Pakistan Times — a 14 August Independence Day AI photobooth that puts you among Pakistan's founders on a vintage newspaper front page.",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm -w client run dev",
    "build": "npm -w client run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@google/genai": "^1.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
