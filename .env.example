# Google Generative Language API key (same Google key that powers Gemini elsewhere).
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=paste-your-key-here

# Optional overrides
PORT=3000
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Image provider: "gemini", "azure", or "openai".
IMAGE_PROVIDER=gemini

# Direct OpenAI image settings.
# Set IMAGE_PROVIDER=openai to use the OpenAI API for image generation.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_OUTPUT_FORMAT=png
# Optional for gpt-image-1 only. Unsupported by gpt-image-1-mini.
OPENAI_IMAGE_INPUT_FIDELITY=

# Keep at 1 for identity accuracy. 1 means Quaid-e-Azam only.
MAX_LEADER_REFERENCES=1

# Azure OpenAI in Azure AI Foundry image settings.
# Set IMAGE_PROVIDER=azure to use these for image generation.
# AZURE_OPENAI_ENDPOINT should look like https://your-resource-name.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-1-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_IMAGE_SIZE=1024x1024
AZURE_OPENAI_IMAGE_QUALITY=low

# Set to 0 to skip the second "face refine" edit pass (saves one image call).
# Enabled by default for better face accuracy.
FACE_REFINE=1

# Manual generation job storage: "file" or "supabase".
# Use "file" for local JSON storage or "supabase" after creating server/sql/manual_jobs.sql.
MANUAL_JOB_STORE=file
SUPABASE_URL=
SUPABASE_KEY=

# Default startup mode. Backoffice can change this at runtime.
GENERATION_MODE=manual

# WaveSpeed AI face-swap API key.
# Used for post-processing: swaps the guest's real face onto the generated scene.
# Get one at https://wavespeed.ai/accesskey
WAVESPEED_API_KEY=
